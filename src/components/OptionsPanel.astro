---
// Modal de opciones con el diseño de Figma (Display Mode 32:250, Language 34:2):
// título, lista de opciones y botón Done. La opción activa muestra su ícono
// sólido y un check a la derecha; las inactivas, el ícono outline y sin check.
// El estado lo controla src/scripts/interactions.ts vía aria-checked.
import type { ImageMetadata } from 'astro';
import check from '../assets/icons/check.svg';
import { getLang, useTranslations } from '../i18n/ui';

export interface Option {
  value: string;
  label: string;
  solid: ImageMetadata;
  outline: ImageMetadata;
  /** Refleja el ícono horizontalmente (la luna de Dark en Figma) */
  mirrored?: boolean;
  /** Para Language: URL de la página en ese idioma */
  href?: string;
  /** Idioma del texto de la opción, si difiere del de la página */
  lang?: string;
  checked?: boolean;
}

interface Props {
  /** display | language: agrupa las opciones para el script */
  group: string;
  title: string;
  options: Option[];
}

const { group, title, options } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
const titleId = `${group}-panel-title`;
---

<div class="options-panel" data-option-group={group}>
  <p id={titleId} class="options-panel__title">{title}</p>

  <div class="options-panel__options" role="radiogroup" aria-labelledby={titleId}>
    {
      options.map((option) => (
        <button
          type="button"
          class="option"
          role="radio"
          aria-checked={option.checked ? 'true' : 'false'}
          tabindex={option.checked ? 0 : -1}
          data-option={option.value}
          data-href={option.href}
          lang={option.lang}
        >
          <span class:list={['option__icon', { 'is-mirrored': option.mirrored }]}>
            <img class="option__solid" src={option.solid.src} width={option.solid.width} height={option.solid.height} alt="" />
            <img class="option__outline" src={option.outline.src} width={option.outline.width} height={option.outline.height} alt="" />
          </span>
          <span class="option__label">{option.label}</span>
          <img class="option__check" src={check.src} width={check.width} height={check.height} alt="" />
        </button>
      ))
    }
  </div>

  <div class="options-panel__actions">
    <button type="button" class="options-panel__done" data-options-done>{t('panel.done')}</button>
  </div>
</div>

<style>
  .options-panel {
    display: flex;
    flex-direction: column;
    gap: 32px;
    /* --menu-max lo define el contenedor (menos espacio si va alineado a la derecha) */
    width: min(375px, var(--menu-max, calc(100vw - 32px)));
    padding: 24px 24px 20px;
    border-radius: var(--radius);
    background: var(--color-overlay);
    color: var(--color-on-overlay);
  }

  .options-panel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: normal;
  }

  .options-panel__options {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 30px;
    padding: 4px 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    line-height: normal;
    text-align: left;
    cursor: pointer;
  }

  .option__icon {
    display: grid;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .option__icon.is-mirrored {
    scale: -1 1;
  }

  .option__icon img,
  .option__check {
    grid-area: 1 / 1;
    filter: var(--overlay-icon-filter);
    transition:
      opacity 250ms var(--ease-out),
      transform 350ms var(--ease-out);
  }

  .option__label {
    flex: 1;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* Inactivo: outline, sin check */
  .option__solid {
    opacity: 0;
    transform: scale(0.6);
  }

  .option__check {
    opacity: 0;
    transform: scale(0.5) rotate(-20deg);
  }

  /* Activo: sólido + check */
  .option[aria-checked='true'] .option__solid {
    opacity: 1;
    transform: none;
  }

  .option[aria-checked='true'] .option__outline {
    opacity: 0;
    transform: scale(1.3);
  }

  .option[aria-checked='true'] .option__check {
    opacity: 1;
    transform: none;
  }

  /* Hover: el resto se atenúa, como en el menú */
  .options-panel__options:hover .option__label {
    opacity: 0.6;
  }

  .option:hover .option__label,
  .option:focus-visible .option__label {
    opacity: 1;
  }

  .option:hover .option__icon {
    transform: scale(1.12);
  }

  .options-panel__actions {
    display: flex;
    justify-content: flex-end;
  }

  .options-panel__done {
    padding: 12px 20px;
    border: 0;
    border-radius: 9999px;
    background: var(--color-done-bg);
    color: var(--color-done-text);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: normal;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .options-panel__done:hover {
    transform: translateY(-2px);
  }

  .options-panel__done:active {
    transform: scale(0.96);
  }
</style>
