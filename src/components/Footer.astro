---
import MenuPanel from './MenuPanel.astro';
import logoFooter from '../assets/logo-footer.svg';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="menu" class="footer" data-zone="footer">
  <div class="panel footer__panel">
    <img
      class="footer__logo"
      src={logoFooter.src}
      width={logoFooter.width}
      height={logoFooter.height}
      alt=""
      aria-hidden="true"
    />

    <!-- El botón de volver arriba es el Dock contraído (src/components/Dock.astro) -->
    <div class="footer__menu">
      <MenuPanel id="footer-menu-title" />
    </div>

    <div class="footer__legal">
      <p>ⓒ{year} {site.name}</p>
      {
        site.links.map((link) => (
          <a href={link.href} class="link-underline" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    height: 100vh;
    height: 100svh;
    min-height: 640px;
    padding: var(--frame);
  }

  .footer__panel {
    position: relative;
    height: 100%;
    overflow: clip;
  }

  /* Logo gigante de fondo: ocupa el ancho del panel y se corta arriba y abajo */
  .footer__logo {
    position: absolute;
    left: 50%;
    top: calc((100vw - 2 * var(--frame)) * -0.1086);
    width: 99.67%;
    height: auto;
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
  }

  /* 117px sobre el borde del panel: deja 18px sobre el botón de volver arriba */
  .footer__menu {
    position: absolute;
    left: 50%;
    bottom: 117px;
    translate: -50% 0;
    border-radius: var(--radius);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transform-origin: bottom center;
    opacity: 0;
    transform: translateY(24px) scale(0.9);
    clip-path: inset(92% 38% 0 38% round var(--radius));
    transition:
      opacity 250ms var(--ease-out),
      transform 600ms var(--ease-out),
      clip-path 600ms var(--ease-out);
  }

  /* Aparece cuando el Dock se contrae al botón de volver arriba */
  :global(body[data-dock="top"]) .footer__menu {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 0 0 round var(--radius));
    /* Espera a que la barra termine de contraerse para crecer desde el botón */
    transition-delay: 280ms;
  }

  .footer__legal {
    position: absolute;
    left: 27px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: var(--text-sm);
    line-height: normal;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .footer__legal p {
    margin: 0;
  }

  @media (max-width: 700px) {
    .footer__legal {
      left: 50%;
      translate: -50% 0;
    }
  }
</style>
