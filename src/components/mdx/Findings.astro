---
// Bloques etiquetados en secuencia (ej. lo que mostró cada prueba y qué cambió).
// Uso en MDX:
//   <Findings items={[{ label: 'What Maze showed', text: '...' }]} />
interface Props {
  items: { label: string; text: string }[];
}

const { items } = Astro.props;
---

<dl class="findings mdx-wide">
  {
    items.map((item, i) => (
      <div class="finding" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
        <dt>{item.label}</dt>
        <dd>{item.text}</dd>
      </div>
    ))
  }
</dl>

<style>
  /* Tarjetas en fila; la última (lo que cambió) lleva el borde de acento */
  .findings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-lg);
  }

  .finding {
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-panel);
  }

  .finding:last-child {
    border: 2px solid var(--color-accent);
  }

  dt {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  dd {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-body);
  }
</style>
