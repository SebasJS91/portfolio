---
// Comparación antes / después. Los elementos con removed: true se tachan.
// Uso en MDX:
//   <BeforeAfter
//     before={{ label: 'Before — 5 features', items: [{ text: 'Reward shop', removed: true }] }}
//     after={{ label: 'After — 3 features', items: [{ text: 'Medication tracker' }] }}
//   />
interface Column {
  label: string;
  items: { text: string; removed?: boolean }[];
}

interface Props {
  before: Column;
  after: Column;
}

const { before, after } = Astro.props;
---

<div class="before-after mdx-wide" data-reveal>
  {
    [before, after].map((column, i) => (
      <div class:list={['before-after__column', { 'is-after': i === 1 }]}>
        <p class="before-after__label">{column.label}</p>
        <ul>
          {column.items.map((item) => (
            <li class:list={{ 'is-removed': item.removed }}>
              {item.removed ? <del>{item.text}</del> : item.text}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  /* Antes: borde punteado y viñetas huecas. Después: borde de acento y viñetas llenas */
  .before-after {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-lg);
  }

  .before-after__column {
    padding: 32px;
    border: 1px dashed color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    border-radius: 16px;
  }

  .before-after__column.is-after {
    border: 2px solid var(--color-accent);
    background: var(--color-panel);
  }

  .before-after__label {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .is-after .before-after__label {
    color: var(--color-accent);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-title);
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border: 2px solid var(--color-text-muted);
    border-radius: 50%;
  }

  .is-after li::before {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  li + li {
    margin-top: 10px;
  }

  .is-removed {
    color: var(--color-text-muted);
    opacity: 0.7;
  }
</style>
