---
// Listas lado a lado, cada una con su título (ej. funciones de Web y de Mobile).
// Uso en MDX:
//   <ListColumns columns={[{ label: 'Web', items: ['Sign up', 'Settings'] }]} />
interface Props {
  columns: { label: string; items: string[] }[];
}

const { columns } = Astro.props;
---

<div class="list-columns mdx-wide">
  {
    columns.map((column, i) => (
      <div class="list-columns__column" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
        <p class="list-columns__label">
          {column.label}
          <span class="list-columns__count">{column.items.length}</span>
        </p>
        <ul>
          {column.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .list-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-lg);
  }

  .list-columns__column {
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-panel);
  }

  .list-columns__label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-title);
  }

  .list-columns__count {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-tag);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-tag-text);
  }

  ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--color-text-body);
  }

  li + li {
    margin-top: 8px;
  }
</style>
