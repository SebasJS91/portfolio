---
// Imagen con pie de foto para usar dentro de un caso de estudio.
// Uso en MDX:
//   import pantalla from './pantalla.png';
//   <Figure src={pantalla} alt="..." caption="..." wide />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Rompe el ancho del texto y ocupa el ancho del contenedor */
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['figure', { 'mdx-wide': wide }]} data-reveal>
  <div class="figure__frame">
    <Image src={src} alt={alt} widths={[640, 1024, 1600]} sizes="(min-width: 1200px) 1200px, 100vw" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-lg);
  }

  .figure__frame {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-panel);
  }

  .figure__frame :global(img) {
    width: 100%;
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
