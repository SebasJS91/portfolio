---
// Barra superior de las páginas internas (el home usa el Hero).
import logo from '../assets/logo.svg';
import logoLight from '../assets/logo-light.svg';
import { site } from '../data/site';
import { getLang, localizedUrl, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<header class="header">
  <a href={localizedUrl(lang, '/')} class="header__logo" aria-label={`${site.name}, ${t('a11y.home')}`}>
    <img class="theme-light-only" src={logo.src} width={logo.width} height={logo.height} alt="" />
    <img class="theme-dark-only" src={logoLight.src} width={logoLight.width} height={logoLight.height} alt="" />
  </a>
  <a href="#about" class="pill" data-about-open>{t('menu.about')}</a>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 21px calc(var(--frame) + 17px) 0 calc(var(--frame) + 27px);
  }

  .header__logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
  }

  .header__logo img {
    width: 32px;
    height: auto;
    transition: transform var(--duration) var(--ease-out);
  }

  .header__logo:hover img {
    transform: rotate(-8deg) scale(1.08);
  }
</style>
