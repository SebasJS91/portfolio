---
// Botón de menú flotante. Su comportamiento según la zona de la página
// (hero / work / footer) se controla con el atributo data-zone del <body>,
// que actualiza src/scripts/interactions.ts.
import menuIcon from '../assets/icons/menu.svg';
---

<a href="#menu" class="menu-button" aria-label="Open menu" data-menu-button>
  <img src={menuIcon.src} width={menuIcon.width} height={menuIcon.height} alt="" />
</a>

<style>
  .menu-button {
    position: fixed;
    right: calc(var(--frame) + 39px);
    bottom: calc(var(--frame) + 37px);
    z-index: 40;
    display: flex;
    align-items: center;
    padding: 8px;
    border-radius: var(--radius);
    transition:
      background var(--duration-fast) var(--ease-out),
      opacity var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .menu-button:hover {
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .menu-button img {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .menu-button:hover img {
    transform: scale(1.08);
  }

  .menu-button:active img {
    transform: scale(0.92);
  }

  /* En el footer el menú ya está visible, así que el botón se oculta */
  :global(body[data-zone='footer']) .menu-button {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }
</style>
