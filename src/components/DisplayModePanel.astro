---
// Modal "Display Mode" (Figma 32:250): Auto / Light / Dark.
// El cambio se aplica al instante; Done cierra el modal.
import OptionsPanel from './OptionsPanel.astro';
import autoSolid from '../assets/icons/display/auto-solid.svg';
import autoOutline from '../assets/icons/display/auto-outline.svg';
import lightSolid from '../assets/icons/display/light-solid.svg';
import lightOutline from '../assets/icons/display/light-outline.svg';
import darkSolid from '../assets/icons/display/dark-solid.svg';
import darkOutline from '../assets/icons/display/dark-outline.svg';
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));

// El check real lo pone el script según la preferencia guardada en el navegador
const options = [
  { value: 'auto', label: t('display.auto'), solid: autoSolid, outline: autoOutline, checked: true },
  { value: 'light', label: t('display.light'), solid: lightSolid, outline: lightOutline },
  // En Figma el ícono de luna está reflejado horizontalmente
  { value: 'dark', label: t('display.dark'), solid: darkSolid, outline: darkOutline, mirrored: true },
];
---

<OptionsPanel group="display" title={t('display.title')} options={options} />
