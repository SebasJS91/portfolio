---
// Modal "Display Mode" (Figma 32:250). La opción activa muestra su ícono sólido
// y un check a la derecha; las inactivas, el ícono outline y sin check.
// El estado lo controla src/scripts/interactions.ts vía aria-checked.
import autoSolid from '../assets/icons/display/auto-solid.svg';
import autoOutline from '../assets/icons/display/auto-outline.svg';
import lightSolid from '../assets/icons/display/light-solid.svg';
import lightOutline from '../assets/icons/display/light-outline.svg';
import darkSolid from '../assets/icons/display/dark-solid.svg';
import darkOutline from '../assets/icons/display/dark-outline.svg';
import check from '../assets/icons/check.svg';

const options = [
  { value: 'auto', label: 'Auto (follow system settings)', solid: autoSolid, outline: autoOutline },
  { value: 'light', label: 'Light', solid: lightSolid, outline: lightOutline },
  // En Figma el ícono de luna está reflejado horizontalmente
  { value: 'dark', label: 'Dark', solid: darkSolid, outline: darkOutline, mirrored: true },
];
---

<div class="display-panel">
  <p id="display-mode-title" class="display-panel__title">Display Mode</p>

  <div class="display-panel__options" role="radiogroup" aria-labelledby="display-mode-title">
    {
      options.map((option) => (
        <button
          type="button"
          class="display-option"
          role="radio"
          aria-checked="false"
          data-display-option={option.value}
        >
          <span class:list={['display-option__icon', { 'is-mirrored': option.mirrored }]}>
            <img class="display-option__solid" src={option.solid.src} width={option.solid.width} height={option.solid.height} alt="" />
            <img class="display-option__outline" src={option.outline.src} width={option.outline.width} height={option.outline.height} alt="" />
          </span>
          <span class="display-option__label">{option.label}</span>
          <img class="display-option__check" src={check.src} width={check.width} height={check.height} alt="" />
        </button>
      ))
    }
  </div>

  <div class="display-panel__actions">
    <button type="button" class="display-panel__done" data-menu-close>Done</button>
  </div>
</div>

<style>
  .display-panel {
    display: flex;
    flex-direction: column;
    gap: 32px;
    /* --menu-max lo define el contenedor (menos espacio si va alineado a la derecha) */
    width: min(375px, var(--menu-max, calc(100vw - 32px)));
    padding: 24px 24px 20px;
    border-radius: var(--radius);
    background: var(--color-overlay);
    color: var(--color-on-overlay);
  }

  .display-panel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: normal;
  }

  .display-panel__options {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .display-option {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    height: 30px;
    padding: 4px 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    line-height: normal;
    text-align: left;
    cursor: pointer;
  }

  .display-option__icon {
    display: grid;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .display-option__icon.is-mirrored {
    scale: -1 1;
  }

  .display-option__icon img,
  .display-option__check {
    grid-area: 1 / 1;
    filter: var(--overlay-icon-filter);
    transition:
      opacity 250ms var(--ease-out),
      transform 350ms var(--ease-out);
  }

  .display-option__label {
    flex: 1;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* Inactivo: outline, sin check */
  .display-option__solid {
    opacity: 0;
    transform: scale(0.6);
  }

  .display-option__check {
    opacity: 0;
    transform: scale(0.5) rotate(-20deg);
  }

  /* Activo: sólido + check */
  .display-option[aria-checked='true'] .display-option__solid {
    opacity: 1;
    transform: none;
  }

  .display-option[aria-checked='true'] .display-option__outline {
    opacity: 0;
    transform: scale(1.3);
  }

  .display-option[aria-checked='true'] .display-option__check {
    opacity: 1;
    transform: none;
  }

  /* Hover: el resto se atenúa, como en el menú */
  .display-panel__options:hover .display-option__label {
    opacity: 0.6;
  }

  .display-option:hover .display-option__label,
  .display-option:focus-visible .display-option__label {
    opacity: 1;
  }

  .display-option:hover .display-option__icon {
    transform: scale(1.12);
  }

  .display-panel__actions {
    display: flex;
    justify-content: flex-end;
  }

  .display-panel__done {
    padding: 12px 20px;
    border: 0;
    border-radius: 9999px;
    background: var(--color-done-bg);
    color: var(--color-done-text);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: normal;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .display-panel__done:hover {
    transform: translateY(-2px);
  }

  .display-panel__done:active {
    transform: scale(0.96);
  }
</style>
