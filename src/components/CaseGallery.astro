---
import { Image } from 'astro:assets';
import type { CaseStudy } from '../i18n/content';

interface Props {
  study: CaseStudy;
  /** Cargar de inmediato (cuando la galería está arriba en la página) */
  eager?: boolean;
}

const { study, eager = false } = Astro.props;
const { gallery, galleryAlt, galleryLayout } = study.data;

// Tamaño de salida aproximado de cada imagen según el layout (para srcset)
const widths = {
  devices: [200, 300, 400, 600, 800],
  centered: [480, 720, 1000, 1400],
  bleed: [720, 1000, 1400, 2000],
  laptop: [800, 1200, 1600, 2200],
}[galleryLayout];

// laptop: la 1.ª imagen es el portátil y la 2.ª el teléfono que va encima
const sizes = { devices: '24vw', laptop: '90vw' }[galleryLayout] ?? '65vw';
---

<div class:list={['gallery', `gallery--${galleryLayout}`]}>
  {
    galleryLayout === 'laptop' ? (
      <div class="gallery__stage">
        {gallery.map((src, i) => (
          <Image
            src={src}
            alt={i === 0 ? galleryAlt : ''}
            widths={i === 0 ? widths : [240, 360, 480, 720]}
            sizes={i === 0 ? sizes : '22vw'}
            loading={eager ? 'eager' : 'lazy'}
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          />
        ))}
      </div>
    ) : (
      gallery.map((src, i) => (
        <Image
          src={src}
          alt={i === 0 ? galleryAlt : ''}
          widths={widths}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        />
      ))
    )
  }
</div>

<style>
  .gallery {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .gallery :global(img) {
    transition:
      opacity var(--duration) var(--ease-out),
      transform 800ms var(--ease-out);
  }

  /* Varias pantallas en fila (499px de alto sobre 600 en Figma) */
  .gallery--devices {
    justify-content: center;
  }

  .gallery--devices :global(img) {
    height: 83.5%;
    width: auto;
  }

  :global(.case__panel:hover) .gallery--devices :global(img.is-visible) {
    transform: translateY(-8px);
  }

  :global(.case__panel:hover) .gallery--devices :global(img.is-visible:nth-child(2)) {
    transform: translateY(-14px);
    transition-delay: 40ms;
  }

  /* Una imagen centrada (696px de ancho sobre 894 en Figma) */
  .gallery--centered {
    justify-content: center;
  }

  .gallery--centered :global(img) {
    width: 77.85%;
  }

  /* Imagen alineada a la izquierda que se sale por la derecha */
  .gallery--bleed {
    justify-content: flex-start;
  }

  .gallery--bleed :global(img) {
    height: 99.8%;
    width: auto;
    max-width: none;
  }

  :global(.case__panel:hover) .gallery--centered :global(img.is-visible),
  :global(.case__panel:hover) .gallery--bleed :global(img.is-visible) {
    transform: scale(1.025);
  }

  .gallery--bleed :global(img) {
    transform-origin: left center;
  }

  /* Portátil con un teléfono encima. El portátil se corta por abajo; si el
     panel es lo bastante ancho se centra entero, y si no, se queda a la
     izquierda (con el margen del teléfono) y se corta por la derecha.
     Medidas en alto del panel (cqh), tomadas de la composición original. */
  .gallery--laptop {
    container-type: size;
    display: block;
  }

  .gallery__stage {
    position: absolute;
    top: 7.87cqh;
    left: max(6.6cqh, (100cqw - 221.8cqh) / 2);
    height: 134.4cqh;
    aspect-ratio: 3660 / 2218;
  }

  .gallery--laptop :global(img) {
    position: absolute;
    max-width: none;
    height: auto;
  }

  .gallery--laptop :global(img:first-child) {
    inset: 0;
    width: 100%;
  }

  .gallery--laptop :global(img:nth-child(2)) {
    left: 0.21%;
    top: 17.96%;
    width: 17.01%;
  }

  :global(.case__panel:hover) .gallery--laptop :global(img.is-visible) {
    transform: translateY(-8px);
  }

  :global(.case__panel:hover) .gallery--laptop :global(img.is-visible:nth-child(2)) {
    transform: translateY(-14px);
    transition-delay: 40ms;
  }
</style>
