---
import { site } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));
---

<button type="button" class="button copy" data-copy={site.email} data-copied={t('copy.done')} aria-live="polite">
  <span data-copy-label>{site.email}</span>
  <span class="copy__icon" aria-hidden="true">⧉</span>
</button>

<style>
  .copy__icon {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .copy:hover .copy__icon {
    transform: rotate(-8deg) scale(1.1);
  }

  .copy:global(.is-copied) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }
</style>
