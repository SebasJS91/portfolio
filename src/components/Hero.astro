---
import { site } from '../data/site';
import { url } from '../utils/url';
---

<section class="hero" data-zone="hero" data-label="Home">
  <div class="panel hero__panel">
    <a href={url('/about')} class="pill hero__about">About</a>

    <div class="hero__title">
      <h1 class="hero__line" style="--i: 0">{site.name.toUpperCase()}</h1>
      <p class="hero__line hero__role" style="--i: 1">{site.role.toUpperCase()}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100vh;
    height: 100svh;
    padding: var(--frame);
  }

  .hero__panel {
    position: relative;
    height: 100%;
    overflow: clip;
    display: grid;
    place-items: center;
  }

  .hero__about {
    position: absolute;
    top: 29px;
    right: 17px;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-inline: var(--space-sm);
    line-height: normal;
    text-align: center;
  }

  h1 {
    font-size: var(--text-2xl);
    color: var(--color-text);
  }

  .hero__role {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  /* El logo y el botón de menú del hero los pone el Dock (src/components/Dock.astro) */

  /* Entrada escalonada al cargar */
  .hero__line {
    animation: rise 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 120ms + 150ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>
