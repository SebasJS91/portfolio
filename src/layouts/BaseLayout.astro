---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import AboutPanel from '../components/AboutPanel.astro';
import { site } from '../data/site';
import { url } from '../utils/url';
import { getLang, languages, switchLanguageUrl, useTranslations, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** El home no usa la barra superior porque el Hero ya la incluye */
  header?: boolean;
  /** Nombre de la sección que muestra el Dock en esta página */
  section?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, description = t('site.description'), header = true, section = t('section.home') } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t('site.role')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// La misma página en cada idioma (para hreflang y para el selector de idioma)
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: switchLanguageUrl(Astro.url.pathname, code),
}));
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={new URL(alt.href, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <!-- Tema: se resuelve antes de pintar para evitar un destello en claro.
         Preferencia guardada: auto | light | dark (auto sigue al sistema). -->
    <script is:inline>
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const getPref = () => {
          try {
            return localStorage.getItem('display-mode') || 'auto';
          } catch {
            return 'auto';
          }
        };
        const apply = () => {
          const pref = getPref();
          const theme = pref === 'auto' ? (media.matches ? 'dark' : 'light') : pref;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.displayMode = pref;
        };
        apply();
        if (!window.__theme) {
          window.__theme = { apply, getPref };
          media.addEventListener('change', apply);
          // La navegación con View Transitions reemplaza los atributos de <html>
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body id="top" data-dock={header ? 'bar' : 'hero'} data-menu="closed" data-menu-view="menu" data-about="closed">
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <!-- La página y la capa fija se desplazan juntas cuando se abre el panel About -->
    <div class="page" data-page>
      {header && <Header />}
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <div class="page-layer">
      <Dock label={section} alternates={alternates} />
      <div class="page-dim" data-about-close aria-hidden="true"></div>
    </div>
    <AboutPanel />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    padding: 0.5rem 1rem;
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: 8px;
    z-index: 100;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
