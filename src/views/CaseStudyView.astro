---
// Página de un caso de estudio (inglés y español)
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseGallery from '../components/CaseGallery.astro';
import arrowIcon from '../assets/icons/arrow-circle.svg';
import arrowIconDark from '../assets/icons/arrow-circle-dark.svg';
import type { CaseStudy } from '../i18n/content';
import { getLang, localizedUrl, useTranslations } from '../i18n/ui';

interface Props {
  study: CaseStudy;
  next?: CaseStudy;
}

const { study, next } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title, summary, tags, cover, galleryAlt, company, role, year, team } = study.data;
const { Content, headings } = await render(study.entry);
// Índice lateral: las secciones (##) del caso
const sections = headings.filter((h) => h.depth === 2);

const meta = [
  { label: t('case.company'), value: company },
  { label: t('case.role'), value: role },
  { label: t('case.year'), value: year?.toString() },
  { label: t('case.team'), value: team },
].filter((item) => item.value);
---

<BaseLayout title={title} description={summary} section={t('section.case')}>
  <div class="progress" data-reading-progress></div>

  <article class="case" data-zone="case" data-label={t('section.case')}>
    <header class="container case__header">
      <p class="eyebrow">{t('case.eyebrow')}</p>
      <h1>{title}</h1>
      <p class="case__summary">{summary}</p>
      {
        tags.length > 0 && (
          <ul class="case__tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="case__cover" data-case-cover>
      {
        cover ? (
          <div class="panel case__cover-panel">
            <Image
              src={cover}
              alt={galleryAlt}
              widths={[600, 1000, 1600]}
              sizes="(min-width: 900px) 60vw, 90vw"
              loading="eager"
            />
          </div>
        ) : (
          // Sin portada propia: la misma galería del home, con su interacción
          <div class="panel case__panel case__cover-gallery">
            <CaseGallery study={study} eager />
          </div>
        )
      }
    </div>

    {
      meta.length > 0 && (
        <dl class="container case__meta">
          {meta.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      sections.length > 1 && (
        <nav class="case-toc" aria-label={t('case.toc')} data-toc>
          <p class="case-toc__label">{t('case.toc')}</p>
          <ol>
            {sections.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="container prose" lang={study.isFallback ? 'en' : undefined}>
      <Content />
    </div>
  </article>

  {
    next && next.slug !== study.slug && (
      <nav class="container next" aria-label={t('case.next')}>
        <a href={localizedUrl(lang, `/work/${next.slug}`)} class="next__link">
          <span class="eyebrow">{t('case.next')}</span>
          <span class="next__title">
            {next.data.title}
            <img class="theme-light-only" src={arrowIcon.src} width={arrowIcon.width} height={arrowIcon.height} alt="" />
            <img class="theme-dark-only" src={arrowIconDark.src} width={arrowIconDark.width} height={arrowIconDark.height} alt="" />
          </span>
        </a>
      </nav>
    )
  }
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 60;
  }

  /* Columna de lectura (760px) dentro del contenedor; los bloques .mdx-wide
     (tarjetas, métricas, figuras anchas) ocupan el contenedor completo */
  .prose,
  .next {
    --case-text: 47.5rem;
  }

  .case__header {
    padding-block: var(--space-xl) var(--space-lg);
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.75rem);
    line-height: 1.08;
    color: var(--color-title);
  }

  .case__summary {
    max-width: 40rem;
    margin: var(--space-md) 0 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-body);
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .case__tags li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-tag);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-tight);
    color: var(--color-tag-text);
  }

  /* Datos del caso: una fila entre líneas, debajo de la portada */
  .case__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-md);
    margin-block: var(--space-lg) 0;
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .case__meta dt {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .case__meta dd {
    margin: 8px 0 0;
    font-family: var(--font-display);
    line-height: 1.35;
    color: var(--color-title);
  }

  .case__cover {
    padding: var(--frame);
  }

  .case__cover-panel {
    display: grid;
    place-items: center;
    padding: var(--space-lg) var(--space-md);
    min-height: 60vh;
  }

  .case__cover-panel :global(img) {
    max-height: 70vh;
    width: auto;
  }

  .case__cover-gallery {
    position: relative;
    overflow: hidden;
    height: clamp(340px, 62vw, 640px);
  }

  /* Imágenes "bleed" vienen cortadas por la derecha: en este panel ancho se
     alinean a la derecha para que el corte coincida con el borde */
  .case__cover-gallery :global(.gallery--bleed) {
    justify-content: flex-end;
  }

  .case__cover-gallery :global(.gallery--bleed img) {
    transform-origin: right center;
  }

  /* Tipografía del contenido MDX */
  .prose {
    padding-top: var(--space-xl);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose > :global(*) {
    max-width: var(--case-text);
    margin-inline: auto;
  }

  .prose > :global(.mdx-wide) {
    max-width: none;
  }

  /* Índice lateral (como nabauer.com): solo cuando hay sitio a la derecha del
     contenedor, desde 1800px. Aparece al pasar la imagen del proyecto y se
     oculta al llegar al footer (data-visible, desde interactions.ts). */
  .case-toc {
    display: none;
  }

  @media (min-width: 1800px) {
    .case-toc {
      position: fixed;
      top: 120px;
      right: 32px;
      z-index: 5;
      display: block;
      width: 200px;
      max-height: calc(100vh - 160px);
      overflow-x: hidden;
      overflow-y: auto;
      scrollbar-width: none;
      opacity: 0;
      visibility: hidden;
      transform: translateX(12px);
      pointer-events: none;
      /* Curva pareja (no la ease-out del sitio, que resuelve casi todo al inicio) */
      transition:
        opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 700ms cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 700ms;
    }

    .case-toc[data-visible] {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      transition:
        opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 700ms cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s;
    }
  }

  .case-toc__label {
    margin: 0 0 12px 14px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .case-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .case-toc a {
    display: block;
    margin-left: -1px;
    /* Margen a la derecha para el desplazamiento de 2px del enlace activo */
    padding: 6px 4px 6px 14px;
    border-left: 1px solid transparent;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .case-toc a:hover {
    color: var(--color-title);
  }

  .case-toc a[aria-current='true'] {
    border-left-color: var(--color-accent);
    font-weight: 500;
    color: var(--color-accent);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-toc {
      transform: none;
    }

    .case-toc a[aria-current='true'] {
      transform: none;
    }
  }

  /* Al saltar desde el índice, el título no queda pegado al borde */
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 120px;
  }

  /* Cada sección abre con su título; mucho aire entre secciones */
  .prose :global(h2) {
    margin-block: var(--space-xl) var(--space-sm);
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-title);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-block: var(--space-lg) var(--space-sm);
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-title);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--color-text-body);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-title);
  }

  /* Solo las listas del texto (no las de las tarjetas) */
  .prose > :global(ul:not(.mdx-wide)),
  .prose > :global(ol) {
    padding-left: 1.1em;
  }

  .prose > :global(ul:not(.mdx-wide)) > :global(li + li),
  .prose > :global(ol) > :global(li + li) {
    margin-top: 6px;
  }

  /* Tablas (GFM): se desplazan horizontalmente en pantallas pequeñas */
  .prose :global(table) {
    display: block;
    width: 100%;
    margin-block: var(--space-lg);
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
    color: var(--color-text-body);
  }

  .prose :global(th) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-title);
  }

  .prose :global(td:first-child) {
    min-width: 10rem;
  }

  .prose :global(blockquote) {
    margin-block: var(--space-lg);
    padding-left: var(--space-md);
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .prose :global(a) {
    color: var(--color-accent);
  }

  .next {
    max-width: var(--case-text);
    margin-block: var(--space-xl);
  }

  .next__link {
    display: block;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
  }

  .next__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .next__title img {
    width: 20px;
    height: 20px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .next__link:hover .next__title {
    color: var(--color-accent);
  }

  .next__link:hover img {
    transform: translateX(6px);
  }
</style>
