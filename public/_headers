# Cloudflare: headers para los archivos estáticos (no aplica a lo que responde worker/index.js)

# Archivos de Astro con hash en el nombre (CSS, JS, imágenes, fuentes): nunca
# cambian, así que el navegador los puede guardar un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon: caché de una semana
/favicon.svg
  Cache-Control: public, max-age=604800
